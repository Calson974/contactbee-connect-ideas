{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-write supabase/functions/generate-vcards/index.ts",
    "compile-vcards": "deno run --allow-net --allow-env --allow-read --allow-write supabase/functions/compile-daily-vcards/index.ts"
  },
  "importMap": "./import_map.json",
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"],
    "strict": true
  },
  "lint": {
    "include": ["supabase/functions/**/*.ts"],
    "exclude": ["**/generated"]
  },
  "fmt": {
    "files": {
      "include": ["supabase/functions/**/*.ts"],
      "exclude": ["**/generated"]
    },
    "options": {
      "useTabs": false,
      "lineWidth": 80,
      "indentWidth": 2,
      "singleQuote": true,
      "semiColons": true
    }
  }
}
